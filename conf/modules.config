/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Sample-level demultiplexing of reads into targets.
    // meta.demux_params is attached to the sample meta at input parsing (from the analysis setup yaml).
    withName: 'CUTADAPT_DEMUX' {
        ext.args   = { meta.demux_params ?: '' }
        publishDir = [
            path: { "${params.outdir}/demux" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per sample x target processes:
    // meta = [id: <sample>_<target>, sample, target, fastqfilter_params, clustering, clustering_params]
    withName: 'VSEARCH_FASTQFILTER' {
        ext.args = {
            def args = []

            if (params.platform == 'ont') {
                args << '--fastq_qmax 93'
            } else if (params.platform == 'pacbio') {
                args << '--fastq_qmax 93'
            } else {
                error "Unsupported platform '${params.platform}'. Supported values: ont, pacbio"
            }

            if (meta.fastqfilter_params) {
                args << meta.fastqfilter_params
            }

            args.join(' ').trim()
        }
        publishDir = [ enabled: false ]
    }

    withName: 'VSEARCH_DEREPLICATE' {
        ext.args   = '--sizeout'
        publishDir = [
            path: { "${params.outdir}/${meta.target}/derep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VSEARCH_CLUSTER' {
        // args2: clustering algorithm, module errors if it is not one of cluster_fast|size|smallmem|unoise
        // args3: one or more vsearch output flags; keep plain output files (no gzip) so downstream steps can consume them
        // args : abundance handling + target-specific parameters from the analysis setup
        ext.args2  = { "--${meta.clustering}" }
        ext.args3  = '--consout --centroids --uc'
        ext.args   = { "--sizein --sizeout ${meta.clustering_params ?: ''}".trim() }
        publishDir = [
            path: { "${params.outdir}/${meta.target}/consensus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
