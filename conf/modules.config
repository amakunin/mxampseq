/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Sample-level demultiplexing of reads into targets.
    // meta.demux_params is attached to the sample meta at input parsing (from the analysis setup yaml).
    withName: 'CUTADAPT_DEMUX' {
        ext.args   = { meta.demux_params ?: '' }
        publishDir = [
            path: { "${params.outdir}/demux" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per sample x target processes: meta = [id: <sample>_<target>, sample, target, clustering, clustering_params]
    withName: 'SEQKIT_FQ2FA' {
        ext.args   = ''
        publishDir = [ enabled: false ]
    }

    withName: 'VSEARCH_DEREPLICATE' {
        ext.args   = '--sizeout'
        publishDir = [
            path: { "${params.outdir}/${meta.target}/derep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VSEARCH_CLUSTER' {
        // args2: clustering algorithm, module errors if it is not one of cluster_fast|size|smallmem|unoise
        // args3: single output flag; the patched module maps --consout to *.consensus.fasta.gz
        // args : abundance handling + target-specific parameters from the analysis setup
        ext.args2  = { "--${meta.clustering}" }
        ext.args3  = '--consout'
        ext.args   = { "--sizein --sizeout ${meta.clustering_params ?: ''}".trim() }
        publishDir = [
            path: { "${params.outdir}/${meta.target}/consensus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
