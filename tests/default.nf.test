nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            def dataDir = new File("$moduleTestDir/data/demux")
            def samplesheet = new File("$launchDir/samplesheet.tsv")
            samplesheet.text = new File(dataDir, 'samplesheet.tsv').text.replace(
                'tests/data/demux/', "${dataDir.absolutePath}/"
            )
            params {
                outdir = "$outputDir"
                input = samplesheet.absolutePath
            }
        }

        then {
            def nonchimeras = [
                'targets/COI/uchime3_denovo/test_COI.nonchimeras.fasta',
                'targets/COI/uchime3_denovo/test2_COI.nonchimeras.fasta',
                'targets/ITS2/uchime3_denovo/test_ITS2.nonchimeras.fasta',
                'targets/ITS2/uchime3_denovo/test2_ITS2.nonchimeras.fasta'
            ]
            def report = "$outputDir/pipeline_info/nf_core_mxampseq_software_versions.yml"
            assertAll(
                { assert workflow.success },
                { assert nonchimeras.every { new File("$outputDir/$it").length() > 0 } },
                {
                    assert new File(report).isFile()
                    def versions = nf_core.nf.test.utils.Methods.readYamlFile(report)
                    assert versions.VSEARCH_CLUSTER.vsearch instanceof String
                    assert !versions.VSEARCH_CLUSTER.vsearch.isBlank()
                    assert !versions.VSEARCH_CLUSTER.containsKey('samtools')
                }
            )
        }
    }
}
