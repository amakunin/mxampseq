                )
                input[0] = false
                input[1] = true
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = params.analysis_setup
                input[7] = params.demux_params
                input[8] = params.anchor_primers
                input[9] = false
                input[10] = false
